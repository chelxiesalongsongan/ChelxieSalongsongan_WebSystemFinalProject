@model StudentGradeManagement.MVC.Models.GradeViewModel

@{
    ViewData["Title"] = "Delete Grade";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold text-danger">Delete Grade</h2>
        <p class="text-muted">
            Review the grade record before confirming deletion.
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <div class="alert alert-warning">
                Are you sure you want to delete this grade record?
                This action cannot be undone.
            </div>

            <dl class="row">
                <dt class="col-sm-4">Student Number</dt>
                <dd class="col-sm-8">
                    @(Model.Student?.StudentNumber ?? "N/A")
                </dd>

                <dt class="col-sm-4">Student Name</dt>
                <dd class="col-sm-8">
                    @(Model.Student == null
                        ? "N/A"
                        : $"{Model.Student.FirstName} {Model.Student.LastName}")
                </dd>

                <dt class="col-sm-4">Subject Code</dt>
                <dd class="col-sm-8">@Model.SubjectCode</dd>

                <dt class="col-sm-4">Subject Name</dt>
                <dd class="col-sm-8">@Model.SubjectName</dd>

                <dt class="col-sm-4">Grade</dt>
                <dd class="col-sm-8">@Model.Grade</dd>

                <dt class="col-sm-4">Remarks</dt>
                <dd class="col-sm-8">@Model.Remarks</dd>

                <dt class="col-sm-4">Semester</dt>
                <dd class="col-sm-8">@Model.Semester</dd>

                <dt class="col-sm-4">School Year</dt>
                <dd class="col-sm-8">@Model.SchoolYear</dd>
            </dl>

            <form asp-controller="Grades"
                  asp-action="DeleteConfirmed"
                  asp-route-id="@Model.GradeId"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-danger">
                    Confirm Delete
                </button>

                <a asp-controller="Grades"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>
