@model StudentGradeManagement.MVC.Models.GradeEditViewModel

@{
    ViewData["Title"] = "Edit Grade";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold">Edit Grade</h2>
        <p class="text-muted">
            Update the student's grade and academic information.
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <form asp-controller="Grades"
                  asp-action="Edit"
                  asp-route-id="@Model.GradeId"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="GradeId" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="StudentId"
                           class="form-label fw-semibold">
                        Student ID
                    </label>
                    <input asp-for="StudentId"
                           type="number"
                           class="form-control"
                           min="1" />
                    <span asp-validation-for="StudentId"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SubjectCode"
                           class="form-label fw-semibold">
                        Subject Code
                    </label>
                    <input asp-for="SubjectCode"
                           class="form-control" />
                    <span asp-validation-for="SubjectCode"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SubjectName"
                           class="form-label fw-semibold">
                        Subject Name
                    </label>
                    <input asp-for="SubjectName"
                           class="form-control" />
                    <span asp-validation-for="SubjectName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Grade"
                           class="form-label fw-semibold">
                        Grade (0–100)
                    </label>
                    <input asp-for="Grade"
                           type="number"
                           class="form-control"
                           min="0"
                           max="100" />
                    <span asp-validation-for="Grade"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Semester"
                           class="form-label fw-semibold">
                        Semester
                    </label>
                    <select asp-for="Semester" class="form-select">
                        <option value="">-- Select Semester --</option>
                        <option value="1st Semester">1st Semester</option>
                        <option value="2nd Semester">2nd Semester</option>
                        <option value="Summer">Summer</option>
                    </select>
                    <span asp-validation-for="Semester"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="SchoolYear"
                           class="form-label fw-semibold">
                        School Year
                    </label>
                    <input asp-for="SchoolYear"
                           class="form-control" />
                    <span asp-validation-for="SchoolYear"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <button type="submit" class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-controller="Grades"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
