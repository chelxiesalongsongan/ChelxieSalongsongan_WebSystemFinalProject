@model List<StudentGradeManagement.MVC.Models.StudentViewModel>

@{
    ViewData["Title"] = "Student Records";
}

<div class="container mt-4">
    <h2>Student Records</h2>
    <p class="text-muted">
        View the list of students registered in the system.
    </p>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    <div class="card shadow-sm mt-3">
        <div class="card-body">
            @if (Model == null || Model.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    No student records found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Student Number</th>
                                <th>Full Name</th>
                                <th>Email</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (StudentGradeManagement.MVC.Models.StudentViewModel student in Model)
                            {
                                <tr>
                                    <td>@student.StudentNumber</td>
                                    <td>@student.FirstName @student.LastName</td>
                                    <td>@student.Email</td>
                                    <td>
                                        @if (student.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="Faculty"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Dashboard
        </a>
    </div>
</div>
