@{
    ViewData["Title"] = "My Grades";

    string apiBaseUrl = ViewBag.ApiBaseUrl;
    string jwtToken = ViewBag.JwtToken;
}

<div class="container mt-4">

    <h2>Welcome, <span id="studentName">Loading...</span>!</h2>

    <p>
        <strong>Student Number:</strong>
        <span id="studentNumber">Loading...</span>
    </p>

    <p class="text-muted">
        Here are your grades and academic records.
    </p>

    <hr />

    <h4>My Grades</h4>

    <div id="message" class="alert alert-info" role="status">
        Loading your grades...
    </div>

    <div class="table-responsive">
        <table id="gradesTable"
               class="table table-striped table-hover"
               style="display: none;">

            <thead class="table-dark">
                <tr>
                    <th>Subject Code</th>
                    <th>Subject Name</th>
                    <th>Grade</th>
                    <th>Remarks</th>
                    <th>Semester</th>
                    <th>School Year</th>
                </tr>
            </thead>

            <tbody id="gradesBody"></tbody>

        </table>
    </div>

    <hr />

    <form asp-controller="Account"
          asp-action="Logout"
          method="post"
          class="mt-3 mb-4">

        @Html.AntiForgeryToken()

        <button type="submit" class="btn btn-danger">
            Logout
        </button>

    </form>

</div>

@section Scripts {
    <script>
        const apiBaseUrl = @Html.Raw(
                                    System.Text.Json.JsonSerializer.Serialize(apiBaseUrl));

        const token = @Html.Raw(
                                    System.Text.Json.JsonSerializer.Serialize(jwtToken));

        const studentName = document.getElementById("studentName");
        const studentNumber = document.getElementById("studentNumber");
        const message = document.getElementById("message");
        const gradesTable = document.getElementById("gradesTable");
        const gradesBody = document.getElementById("gradesBody");

        async function loadStudentDashboard() {
            try {
                // Fetch the logged-in student's profile.
                const profileResponse = await fetch(
                    `${apiBaseUrl}/api/Students/my-profile`,
                    {
                        method: "GET",
                        headers: {
                            "Authorization": `Bearer ${token}`,
                            "Accept": "application/json"
                        }
                    }
                );

                if (!profileResponse.ok) {
                    throw new Error(
                        profileResponse.status === 401 ||
                            profileResponse.status === 403
                            ? "Your session is invalid or unauthorized. Please log in again."
                            : "Unable to load your student profile."
                    );
                }

                const profile = await profileResponse.json();

                studentName.textContent =
                    profile.fullName || "Student";

                studentNumber.textContent =
                    profile.studentNumber || "Not available";

                // Fetch the grades allowed for this student.
                const gradesResponse = await fetch(
                    `${apiBaseUrl}/api/Grades/my-grades`,
                    {
                        method: "GET",
                        headers: {
                            "Authorization": `Bearer ${token}`,
                            "Accept": "application/json"
                        }
                    }
                );

                if (!gradesResponse.ok) {
                    throw new Error(
                        gradesResponse.status === 401 ||
                            gradesResponse.status === 403
                            ? "You are not authorized to view these grades. Please log in again."
                            : "Unable to load grades. Please try again."
                    );
                }

                const grades = await gradesResponse.json();

                gradesBody.replaceChildren();
                gradesTable.style.display = "none";

                if (!Array.isArray(grades) || grades.length === 0) {
                    message.className = "alert alert-info";
                    message.textContent = "No grades available yet.";
                    return;
                }

                // Display each grade safely.
                grades.forEach(function(grade) {
                    const row = document.createElement("tr");

                    const values = [
                        grade.subjectCode,
                        grade.subjectName,
                        grade.grade,
                        grade.remarks,
                        grade.semester,
                        grade.schoolYear
                    ];

                    values.forEach(function(value) {
                        const cell = document.createElement("td");
                        cell.textContent = value ?? "";
                        row.appendChild(cell);
                    });

                    gradesBody.appendChild(row);
                });

                gradesTable.style.display = "";

                message.className = "alert alert-success";
                message.textContent = "Grades loaded successfully.";

            } catch (error) {
                message.className = "alert alert-danger";

                if (error instanceof TypeError) {
                    message.textContent =
                        "Unable to connect to the API. Check if the API is running and CORS is configured.";
                } else {
                    message.textContent =
                        error.message ||
                        "An error occurred while loading your dashboard.";
                }
            }
        }

        loadStudentDashboard();
    </script>
}
